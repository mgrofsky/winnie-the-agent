# Template configuration for Winnie the Agent. Copy it to SSH/config.ini and edit.
# We provide reasonable defaults for most configuration items, but you should 
# review this before using it in production. 

[honeypot]
# The name of the file you wish to write the honeypot log to.
# Relative paths are resolved from this config file's directory.
log_file = ssh_log.log 

# The name of the sensor, used to identify this honeypot in the logs.
# If you leave this blank, the honeypot will use the system's hostname.
sensor_name = winnie

# Writable runtime state (budget counters, sensor seed). Relative paths resolve from this
# file's directory. Defaults to <repo>/data; the WINNIE_DATA_DIR environment variable
# overrides it (containers set it to their data volume).
#data_dir = ../data

# Settings for the SSH honeypot
[ssh]
# The port the SSH honeypot will listen on. You will probably want to set 
# this to 22 for production use.
port = 8022
# Address to listen on. Empty (the default) listens on every address; set 127.0.0.1 to
# keep a local test off the network.
#listen_host = 127.0.0.1
# The host key to use for the SSH server. This should be a private key.
# See the README for how to generate this key.
host_priv_key = ssh_host_key
# The server version string to send to clients. The SSH server automatically 
# prepends "SSH-2.0-" to this. So "OpenSSH_8.2p1 Ubuntu-4ubuntu0.3" will 
# be transformed to "SSH-2.0-OpenSSH_8.2p1 Ubuntu-4ubuntu0.3".
server_version_string = OpenSSH_8.2p1 Ubuntu-4ubuntu0.3
# Seconds allowed to finish authenticating, seconds without input before an interactive
# session is logged out, and the absolute session lifetime. Each frees a concurrency slot.
login_timeout = 60
idle_timeout = 300
session_timeout = 1800

# Settings to configure which LLM backend to use.  Only one stanza 
# should be uncommented at a time.
[llm]
##### OpenAI
llm_provider = openai
model_name = gpt-4o

##### Azure OpenAI
#llm_provider = azure 
#azure_deployment = gpt-4o 
#azure_api_version = 2025-01-01-preview
#azure_endpoint = <your endpoint url>
#model_name = gpt-4o

##### ollama llama3
#llm_provider = ollama
#model_name = llama3.3

##### Any model via Amazon Bedrock
# Valid AWS model names can be found here: https://docs.aws.amazon.com/bedrock/latest/userguide/model-ids.html
#llm_provider = AWS
#model_name = anthropic.claude-3-5-sonnet-20240620-v1:0
# NOTE: Bedrock is not supported on all AWS regions.
#aws_region = us-east-1 
#aws_credentials_profile = default

##### Google Gemini
#llm_provider = gemini
#model_name = gemini-1.5-pro

##### Anthropic Claude (direct API)
# The API key is read from the ANTHROPIC_API_KEY environment variable. Never put a
# key in this file. temperature is ignored for this provider (current Claude models
# reject non-default sampling parameters).
#llm_provider = anthropic
#model_name = claude-haiku-5-5
#max_tokens = 2048

# Temperature controls randomness in LLM responses. Values usually range from 0.0 to 2.0.
# Lower values (e.g., 0.2) make responses more focused and deterministic.
# Higher values (e.g., 0.8) make responses more creative and variable.
# Not set by default: the provider's own default is used. Some current models (for example
# recent Claude models on Amazon Bedrock) reject this parameter, and every model call then
# fails with a `Model error` event. The anthropic provider never sends it.
#temperature = 0.2

# The maximum number of tokens to send to the LLM backend in a single 
# request. This includes the message history for the session, so should
# be fairly high. Not all models support large token counts, so be sure 
# to test this with your model.
trimmer_max_tokens = 64000

# Answer known commands from the scenario's host profile instead of the model. Facts no
# command can change (uname -r, uptime, nproc, free, /proc/cpuinfo, lscpu, lspci,
# nvidia-smi, the IoT openers, busybox probes) are answered locally for the whole session;
# facts a session can change (hostname, id, whoami, which, ls, pwd, ps, df, /etc files,
# paths that do not exist yet) only until a model reply has answered a command. cd, export
# and downloads always go to the model. A local answer ends with the prompt the model
# showed last; if that prompt does not show the working directory, local answers stop for
# the session. No tokens, and the same answers a sensor without a model gives. The answers
# are added to the session history so the model stays consistent. Set to false to send
# every command to the model.
local_shell_replies = true

# Wait this many milliseconds (a random half to all of it, at most 2000) before a reply
# made without a model call (local, cached or past the model cap), so it is not instant
# next to model replies. 0 answers at once.
local_reply_delay_ms = 0

# When a model reply breaks character, is empty, or misprints a literal echo, ask the model
# this many more times (0 to 2) with a short note and two example replies before falling
# back to the shell's own reply. A retry costs tokens like any call and counts as one
# command with the first. 0 replaces the reply at once.
persona_retries = 1

# Learned replies: keep the model's reply to a command once the same reply was seen in
# learned_min_sessions sessions (2 or more), from two or more source networks (/24, /64),
# after two or more different earlier input lines, and never a different reply. Later
# sessions get that reply with no model call, until the host profile, scenario, model or
# system prompt changes. Random-looking tokens (UUIDs, long hex or base64 runs) in the
# command are placeholders. Sessions that typed a line able to change what later commands
# print (cd, a redirect, a download, a write) neither teach nor get learned replies by that
# rule. A second rule serves a line whose whole session so far (every line and reply) matched
# learned_min_sessions earlier sessions from two or more networks, so a replayed script is
# answered in full, writes included.
# Stored in learned_replies.json beside [budget] state_file (mode 0600), at most
# learned_max_entries entries (up to 3000). Off reads and writes no file.
# python -m agents learned --stats | --list | --candidates | --forget ID | --clear
learned_replies = true
learned_min_sessions = 3
learned_max_entries = 2000

# Mark the persona prompt for the provider's prompt cache. Default: on for anthropic; off
# for aws, because not every Claude or Nova model on Bedrock accepts cache points. Set to
# true to use it on aws (Claude and Nova model ids only). If the first request with a
# cache point is refused as invalid, it is retried without one and caching stays off until
# restart ("Prompt caching disabled" in the log). Ignored for other providers.
#prompt_caching = true

# Description of the emulated system for the telnet persona, relative to this file. The
# SSH server takes it from --prompt-file instead (default: prompt.txt).
#prompt_file = prompt.txt

# System prompt for the LLM. This will be the same for any running instance.
# Change this if you need to tweak behaviors of the simulation itself.
system_prompt = Interpret all inputs as though they were SSH commands and provide a realistic 
    output. Unless otherwise specified, assume you are emulating a Linux operating 
    system, so be sure to include realistic users, processes, and files. Do not 
    include extraneous formatting in your responses. Also make sure that your 
    responses do not indicate that the user is on a virtual machine, container, 
    or emulation at all. 

    If {interactive} is True, make sure to include a realistic MOTD on the
    first call, and to end all responses with a realistic shell prompt to display to 
    the user, including a space at the end. Answer only the one input you were
    given: its output, then one prompt, then stop. Never type a further command
    after that prompt, never answer one, and do not repeat the input line itself.

    If {interactive} is False, do not include a shell prompt or MOTD.

    Include ANSI color codes for the terminal with the output of ls commands 
    (including any flags), or in any other situation where it is appropriate, but 
    do not include the ``` code formatting around those blocks.

    Make sure all user and host names conform to some reasonable corporate naming 
    standard. Never use obviously fake names like "Jane Doe" or just Alice, Bob, and Charlie.

    If at any time the user's input would cause the SSH session to close (e.g., if 
    they exited the login shell), your only answer should be "YYY-END-OF-SESSION-YYY"
    with no additional output before or after. Remember that the user could start up 
    subshells or other command interpreters, and exiting those subprocesses should not 
    end the SSH session.

    Assume the username is {username}.

# The valid user accounts and passwords for the SSH server, in the
# form "username = password".  Note that you can enable login without 
# a password by leaving that field blank (e.g., "guest =" on a line by
# itself). You can set an account to accept ANY password, including an empty
# password, by setting the password to "*"
[user_accounts]
guest = 
user1 = secretpw
user2 = password123
root = *

# ---------------------------------------------------------------------------
# Agent layer (see docs/architecture.md). Everything below is optional; the server
# runs with safe defaults when a section is missing.
# ---------------------------------------------------------------------------

# Spend and concurrency limits for the persona model, enforced in code. When a
# limit is hit the model is not called: the attacker gets a canned fork/resource
# error and the session closes. Token counts use provider usage metadata when
# present, otherwise characters/4 over the session history.
[budget]
# A command costs about the size of the system prompt plus the session so far; with the
# default prompt and a scenario that is roughly 5,000 tokens for an early command, so the
# session default allows on the order of 50 commands.
max_line_bytes = 2048
max_commands_per_session = 200
# Commands per session the model may be asked, failed calls included. Local answers and
# cached replies do not count, and cached replies are still served past it. Past it the session stays open and the deterministic shell answers (unknown
# commands get "command not found"); a "Model cap reached" event is logged once.
max_model_commands_per_session = 50
max_tokens_per_session = 400000
max_tokens_per_ip_per_day = 1000000
max_tokens_per_day = 3000000
max_concurrent_sessions = 20
max_concurrent_sessions_per_ip = 3
# Model replies kept in memory and served again, without a model call, to a session whose
# history so far is identical, inputs and replies (bots replaying one script). A session
# stops using the cache once its history holds anything another session could not share:
# a local answer showing the clock or its own address (w, who, uptime, ps), a model error
# or fallback, or a reply that was not stored. Not kept across restarts, never for a
# source with a planted token or a deep/shallow mode. 0 turns the cache off.
reply_cache_entries = 2000
reply_cache_max_age = 21600
# Daily counters (global and per source; IPv6 sources count per /64) persist here, shared
# by the SSH server and the listeners on the same host through a file lock, so a restart
# does not reset the day. Relative paths resolve inside the data directory.
state_file = budget_state.json

# One scenario pack makes the whole sensor look like one coherent target.
# Names: sip_provider, contact_center, bank, saas, api_platform, healthcare
# (python -m listeners --list-scenarios). Changing it needs a restart.
[scenario]
active = sip_provider
# Seed for deterministic fake data and honeytokens. By default a random seed is created
# once in the data directory (file sensor_seed, mode 0600); keep that file to keep the same
# records across rebuilds. Never derive it from anything public.
#seed =
# Tuner-owned overlay: fake accounts for every service (including SSH), SIP extensions,
# lures, after_n bounds. Merged over [user_accounts] (configured accounts always win).
# The tuner writes only this file. WINNIE_OVERLAY overrides the path.
overlay = ../decoy/overlay.json

# Low-interaction login traps (python -m listeners). Per-service keys override
# the scenario: <service>_enabled, <service>_port, <service>_accept
# (all | listed | after_n | none) and <service>_auth (only postgres uses it, see below).
# Services: sip ftp telnet postgres mysql mssql redis smtp http mllp s3.
[listeners]
bind_host = 0.0.0.0
# Defaults to [honeypot] log_file so all protocols share one log.
#log_file = ssh_log.log
#sip_port = 5060
#mssql_enabled = false
# Reads before login time out sooner than after login. A connection that sends fewer
# than min_progress_bytes within progress_window seconds is closed.
pre_login_timeout = 20
read_timeout = 60
session_timeout = 600
min_progress_bytes = 8
progress_window = 30
max_line_bytes = 4096
max_conn_bytes = 1048576
# Connection slots: all services, one source (IPv6: per /64), one service, one source on
# one service.
max_connections = 256
max_connections_per_ip = 8
max_connections_per_service = 64
max_connections_per_ip_per_service = 4
rate_per_ip_per_minute = 60
# UDP (SIP) responses: per source and for all sources together.
udp_responses_per_ip_per_minute = 20
udp_responses_per_second = 50
# Inbound UDP datagrams from all sources together, checked before any parsing. The rest
# are dropped silently and counted in one aggregated log line per minute. Events from
# sources that never completed a SIP nonce round trip are aggregated like low-value lines.
udp_requests_per_second = 200
# A UDP response is never larger than its request. Some real clients send REGISTERs
# smaller than the 401 challenge and then get no answer; allowing a little slack
# (e.g. 128 bytes, max 512) answers them at the cost of a small, rate-capped
# amplification factor.
sip_udp_slack_bytes = 0
# Ceilings for low-value log lines (refused connections, malformed datagrams). Lines about
# UDP sources that never answered a SIP nonce (possibly forged) have their own ceiling, so
# a forged flood cannot crowd out the rest. Suppressed lines are counted and reported in a
# summary line per protocol every minute, which the daily digest lists.
low_value_events_per_second = 20
unverified_events_per_second = 20
max_commands_per_connection = 500
# Uploads (FTP STOR): stored once per SHA-256, mode 0600, never read back or run. Usage is
# recomputed from disk at start. Upload bytes are bounded by these caps, not by
# max_conn_bytes: an upload over quarantine_max_file_bytes is cut at the cap, stored and
# logged as truncated; over a per-source or total quota reading stops and nothing is kept.
quarantine_dir = ../quarantine
quarantine_max_file_bytes = 5242880
quarantine_per_ip_bytes = 20971520
quarantine_total_bytes = 104857600
# FTP passive mode: data ports to listen on (publish the same range in Docker) and the
# address to advertise (default: the local address of the control connection).
ftp_pasv_ports = 30000-30019
#ftp_pasv_address = 203.0.113.10
# An unused passive listener closes after this many seconds; one source may hold at most
# ftp_pasv_per_ip open passive listeners.
ftp_pasv_accept_timeout = 30
ftp_pasv_per_ip = 2
# PostgreSQL password exchange: md5 (default) or cleartext.
#postgres_auth = md5
# Free-form answers (unknown SQL and API routes after login, Redis commands the trap does
# not implement, unknown web paths, telnet persona) use the budgeted model only when this
# is true; otherwise protocol errors.
llm = false
model = claude-haiku-5-5
llm_max_inflight = 4
llm_timeout = 20
# Requests per answer (1 to 3). When an answer fails the schema, the next request adds
# worked examples and names the problem. A timeout or provider error is not retried.
llm_attempts = 2
# Seconds all requests for one answer share, at most llm_timeout (0 means llm_timeout).
# A second request starts only with at least 1 second left. With llm_attempts = 1 the one
# request gets llm_timeout.
llm_deadline = 12
# With llm = true and the [llm] provider's key set, telnet sessions use the SSH persona
# model; false keeps the canned telnet shell.
#telnet_persona = true

# Analyst agents (python -m agents ...)
[agents]
# Analyst model provider: anthropic (key from ANTHROPIC_API_KEY in the environment) or
# bedrock (Amazon Bedrock, credentials from the standard AWS chain: an instance role, the
# environment, or the profile named below). With bedrock, model is a Bedrock model or
# inference profile id, for example us.anthropic.claude-haiku-5-5. The same provider answers
# the listeners' free-form questions when [listeners] llm is true.
provider = anthropic
model = claude-haiku-5-5
#aws_region = us-east-1
#aws_credentials_profile = default
# Analyst model calls: shared by every stage of one run, and capped per UTC day.
max_llm_calls_per_run = 20
max_analyst_calls_per_day = 500
max_tuner_changes_per_run = 3
# Triage writes at most this many records per run (the rest wait for the next run), and
# removes session and campaign records older than record_retention_days (0 keeps them).
max_records_per_run = 1000
record_retention_days = 90
# Detect: each row of detections/pending/blocklist-candidates.csv expires this many days
# after the source was last seen, and the next run leaves it out. Sources that got past a
# login or used a planted credential keep the longer period.
blocklist_expiry_days = 14
blocklist_access_expiry_days = 30
# Readers that must have handled the event log before it is rotated (the log_rotation result
# of triage, ship and run-all). triage always counts, and so does the export when
# [connector.s3_events] is enabled in this same config. List a reader that runs in another
# container, with its own state directory, so this container never reports an all-clear for
# a log that reader has not finished: log_readers = triage, ship
#log_readers =

# Response playbooks (playbooks/*.toml; python -m agents respond / queue / approve / reject).
# Local steps (tarpit, deepen, shallow, plant_token, tag_source, capture_more) change only
# this honeypot and run automatically. Notify steps run only through connectors enabled
# below. Enforce steps (export_blocklist, publish_detection, open_ticket, block_webhook)
# never run automatically: with queue_enforce on they are queued and run only after
# `python -m agents approve <id>`; approvals expire.
[respond]
enabled = true
queue_enforce = false
approval_ttl_hours = 72
lookback_hours = 48
# Approved blocklist written for the firewall to consume (nothing is pushed anywhere).
#blocklist_file = /agents/reports/blocklist/approved.txt
# blocklist_format: plain | nftables (a complete `nft -f` file: table inet winnie with
# separate IPv4 and IPv6 interval sets) | csv
blocklist_format = plain
# Approved entries expire after this many days; `python -m agents unblock <ip-or-network>`
# removes one sooner.
blocklist_ttl_days = 30
# Two stages for export_blocklist. false: approving writes the address straight to the
# blocklist file (above). true: approving only puts it on the tracked list (tracked.json,
# written next to the blocklist file, for your cloud to watch; see [connector.tracked_export])
# and nothing is blocked; `python -m agents enforce <address>` (or Enforce in the console) is
# a second, separate decision that moves it to the blocklist file and calls
# [connector.block_webhook] if enabled. Entries approved before this was turned on stay
# enforced.
track_before_enforce = false
# A rejected request is not queued again for the same (playbook, source, action) for this
# long; an approval that expired undecided is held back for expired_suppress_hours.
reject_suppress_hours = 168
expired_suppress_hours = 24
# Notifications and approval summaries are built from structured fields. The model-written
# narrative is left out unless this is true; then it is labelled untrusted and stripped of
# mentions and markup.
include_narrative = false
# Addresses and networks no action of any tier may target (your own, monitoring, CDN and
# resolver ranges), comma or space separated. Non-global addresses (private, loopback,
# link-local, CGNAT, multicast, reserved) are always refused.
#never_act_on = 198.51.100.0/24, 2001:db8:10::/48
# When more than proxy_threshold of at least proxy_min_records records in the window come
# from one non-global address (a proxy hiding client addresses), per-source local and
# enforce actions are refused for that run and a warning is logged.
proxy_threshold = 0.5
proxy_min_records = 20
# Notify caps: each playbook may send at most notify_max_per_playbook notifications per
# connector per day; notify_reserved_share of each connector's max_per_day is kept for
# priority playbooks (priority = true). Dropped notifications are recorded and reported in
# one "N notifications suppressed" notice per connector at most every
# suppressed_notice_minutes.
notify_max_per_playbook = 50
notify_reserved_share = 0.25
# Daily cap assumed for a connector whose own max_per_day is unknown.
#notify_default_cap = 200
suppressed_notice_minutes = 60
# Retention: keep the last snapshot_keep source-state snapshots plus any younger than
# snapshot_keep_days; decided approvals and run records older than retention_days are
# removed. A warning is logged when approvals, run records and snapshots together exceed
# size_alarm_mb.
snapshot_keep = 200
snapshot_keep_days = 7
retention_days = 30
size_alarm_mb = 500

# Operator console (python -m agents ui): a small web UI on loopback, reached through an SSH
# or SSM tunnel. The sign-in token comes from WINNIE_UI_TOKEN or is generated at start and
# logged once as a sign-in link; it is never read from this file.
[ui]
# Port to listen on.
port = 8480
# Address to bind; anything but loopback is refused unless --allow-non-loopback is given.
bind = 127.0.0.1
# Allow approve, reject and unblock from the console (--actions turns it on for one run).
actions = false
# Name recorded with decisions made in the console (--by overrides it).
#operator = oncall
# HTTPS name of a reverse proxy on this host that forwards to the port above (--external-host
# overrides it). Empty: loopback names only. See docs/operations.md, "Reaching it".
#external_host = sensor.example-tailnet.ts.net
# Event-log lines the Activity screen keeps in memory (one small entry each, oldest
# dropped first; 1000 to 500000). Worst case about 115 MiB at the default and 275 MiB at
# 500000; see docs/operations.md, "The indexed window".
#activity_entries = 200000

# Outbound connectors. All disabled by default. Destinations must be https and public
# (allow_private = true to permit internal ones). Secrets are environment variable NAMES.
# Every connector below also accepts these keys (defaults shown):
#   max_per_day = 200       sends per day before the connector stops
#   timeout = 10            seconds per send (at most 30)
#   allow_private = false
#   secret_file =           absolute path of a file holding the token, instead of secret_env
# The HTTP connectors (all but email) send secret_env's value in the header named by
# header (default Authorization).
#[connector.webhook]
#enabled = false
#url = https://hooks.example.com/services/T000/B000/XXXX
#secret_env = WINNIE_WEBHOOK_TOKEN
#max_per_day = 200

#[connector.siem_http]
#enabled = false
#url = https://siem.example.com/collector/event
#secret_env = WINNIE_SIEM_TOKEN

#[connector.email]
#enabled = false
#host = smtp.example.com
#port = 587
#starttls = true
#from = honeypot@example.com
#to = soc@example.com
#username_env = WINNIE_SMTP_USER
#password_env = WINNIE_SMTP_PASSWORD

# Enrichment sends attacker IP addresses to the configured third party.
#[connector.enrich]
#enabled = false
#url = https://reputation.example.com/v1/ip/{ip}
#secret_env = WINNIE_ENRICH_KEY
#header = X-API-Key

#[connector.ticket]
#enabled = false
#url = https://tickets.example.com/api/issues

#[connector.block_webhook]
#enabled = false
#url = https://firewall-manager.example.com/api/block

# Event export (python -m agents ship; also the last step of run-all). Sends the event log
# to S3 as JSON lines, from the agents process only. Credentials come from the default AWS
# chain (instance role or environment), never from this file. Delivery is at least once.
# Keys: <prefix>YYYY/MM/DD/HH-<epoch>-<sensor>-<n>-<random>.jsonl (UTC time of the run;
# <random> is 8 hex digits so runs in the same second never share a key).
#[connector.s3_events]
#enabled = false
#bucket = example-honeypot-events
#prefix = events/
# Optional: the bucket's region, and the bucket owner's account id (ExpectedBucketOwner).
#region = us-east-1
#bucket_owner = 123456789012
#source = aws.honeypot
# layout: wrapped ({"source": ..., "detail": event} per line) | flat (the event itself)
#layout = wrapped
# passwords: hash (keyed with the sensor seed; equal passwords compare equal on one sensor)
# | clear | drop. Covers every captured password or secret field on every protocol.
#passwords = hash
#max_events_per_object = 5000
#max_objects_per_run = 50
#max_bytes_per_object = 5242880
#timeout = 10

# Tracked export (python -m agents ship; also the last step of run-all). Sends tracked.json,
# the tracked list written by [respond] track_before_enforce, whole, only when it changed.
# kind = s3: PutObject of exactly one key (the client refuses every other operation, bucket
# and key). Credentials come from the default chain, never from this file.
# kind = https: one PUT or POST of the document, with the HTTP connector rules above.
#[connector.tracked_export]
#enabled = false
#kind = s3
# Where to read tracked.json when this process does not see the agents' reports directory
# (default: next to the blocklist file).
#file = /blocklist/tracked.json
#bucket = example-honeypot-events
#key = events/tracked/tracked.json
#region = us-east-1
#bucket_owner = 123456789012
# Another store that speaks the S3 API (https only; allow_private for an internal one).
#endpoint_url = https://s3.example.com
#url = https://intel.example.com/api/winnie/tracked
#method = PUT
#secret_env = WINNIE_TRACKED_TOKEN
#header = Authorization

# Sightings: where else your environment saw a listed address, shown on the console's
# blocklist screen. Display only; nothing acts on them. The file is untrusted and checked
# strictly; a refused file keeps the last good one. See docs/operations.md, "Sightings".
[sightings]
# Default: sightings.json in the agents' state directory.
#path = /agents/state/sightings.json
max_bytes = 1048576
max_entries = 5000
# The console marks the file stale when its generated_at is older than this.
stale_hours = 48

# Where source addresses are: country, region, city and network owner (AS number), shown in
# the console and the digest and stored on each triage record. Read from MaxMind-format
# .mmdb files on disk (MaxMind GeoLite2 City / ASN or DB-IP Lite City / ASN) with the
# optional maxminddb package; no network call of any kind. Off unless a path is set; a
# missing file or package leaves it off. Replace a file by renaming a new copy into place;
# it is picked up within a minute. See docs/operations.md, "Where addresses are".
#[geoip]
#city_db = /geoip/dbip-city-lite.mmdb
#asn_db = /geoip/dbip-asn-lite.mmdb
# Credit line the console shows in its footer as plain text. The free databases require
# one; DB-IP Lite (CC BY 4.0) asks for "IP Geolocation by DB-IP" with a link to db-ip.com.
#attribution = IP Geolocation by DB-IP (db-ip.com)

# Optional sightings fetch (python -m agents ship; also run-all), at most once per
# interval_minutes. kind = s3: GetObject of exactly one key; kind = https: GET. The local
# file is replaced only by a copy that passes the checks.
#[connector.sightings]
#enabled = false
#kind = s3
#interval_minutes = 15
#bucket = example-honeypot-events
#key = sightings/sightings.json
#region = us-east-1
#bucket_owner = 123456789012
#endpoint_url = https://s3.example.com
#url = https://intel.example.com/api/winnie/sightings
#secret_env = WINNIE_SIGHTINGS_TOKEN
#header = Authorization

# Optional: what Shodan InternetDB (https://internetdb.shodan.io, no key) already knows about
# interesting source addresses: open ports, host names, tags, CPEs and known CVE ids, shown
# in the console and stored on triage records. Looked up by run-all / ship in the agents
# container (never a honeypot container), one HTTPS GET per address with only the address
# in it. Free for non-commercial use; a company may use it internally but not in a product
# it charges for. The destination is fixed in code. See docs/operations.md, "What Shodan
# already knows about a source".
#[connector.internetdb]
#enabled = false
# Lookups per run and per UTC day; one request at a time, at least min_interval_seconds apart.
#max_per_run = 100
#max_per_day = 2000
#min_interval_seconds = 1
# An answer (also "no information") is kept this long; InternetDB is refreshed weekly.
#cache_days = 7
# Records seen in this window are considered (SUSPICIOUS, MALICIOUS or a honeytoken used).
#lookback_days = 7
# Addresses kept in the local file; the oldest answers are dropped first.
#max_entries = 5000
# direct: this process asks InternetDB (above). delivered: it never does. run-all writes the
# addresses it wants looked up (addresses only, at most max_wanted) to wanted_file, something
# outside the sensor answers through the object store, and every answer is checked here
# exactly like a direct one before it reaches answers_file, which triage and the console
# read. See docs/operations.md, "Delivered answers".
#mode = direct
#max_wanted = 500
# Default: internetdb_wanted.json next to the blocklist file (as tracked.json).
#wanted_file = /blocklist/internetdb_wanted.json
# Default: internetdb.json in the agents' state directory.
#answers_file = /internetdb/internetdb.json
# A delivered answer older than this is not accepted.
#max_age_days = 30

# Delivered mode only, run by ship / run-all in the process with the credentials or egress. s3:
# PutObject of the wanted list to one key, GetObject of the answers from another; the
# answers object is refused whole above max_bytes or max_entries; each answer is checked on
# its own. kind = lookup: no object store and nothing outside the sensor; this process reads
# the wanted list and asks InternetDB itself, with the caps, pacing and cache set above, and
# keeps its own state in its state directory; it writes the checked answers to
# answers_file. Put it in the exporter's config only (on AWS, InternetDbLookup does), never
# in the config of a process that must not reach the internet. See docs/operations.md,
# "The exporter asks InternetDB".
#[connector.internetdb_exchange]
#enabled = false
#kind = s3
# kind = lookup only: connect only to these IPv4 addresses (one per line, at most 8), the
# ones the host firewall lets this process reach (deploy/aws/host/sensor-egress.sh).
#addresses_file = /egress/internetdb-addresses
#bucket = example-honeypot-events
#wanted_key = events/internetdb/wanted.json
#answers_key = internetdb/answers.json
#region = us-east-1
#bucket_owner = 123456789012
#endpoint_url = https://s3.example.com
#interval_minutes = 15
#max_bytes = 4194304
#max_entries = 1000

# Confirmed indicators to an AlienVault OTX pulse (off by default). run-all writes the
# candidates (source addresses and upload hashes only, from sources whose address is proven
# and that did more than probe) to candidates_file; the process with submit = true adds what
# it has not sent before to one pulse per UTC day. The destination is fixed in code
# (otx.alienvault.com). A public pulse shows anyone that this operator runs a honeypot and
# roughly when each source hit it. See docs/operations.md, "Indicators to OTX".
#[connector.otx]
#enabled = false
# true: write what would be sent to otx_dry_run.json in the state directory and send
# nothing. Sending needs enabled = true and dry_run = false.
#dry_run = true
# false: only write the candidates (the agents container on AWS, which has no egress).
#submit = true
# Also submit the SHA-256 of whole files the quarantine kept from those sources.
#hashes = true
# The API key: an environment variable name or a file (one line), not both.
#secret_env = WINNIE_OTX_KEY
#secret_file = /run/otx-key
# The pulse is named "<pulse_name> <YYYY-MM-DD>".
#pulse_name = Honeypot sources
#description = Source addresses and uploaded file hashes seen by a honeypot sensor.
#tags = honeypot
# white | green | amber | red; a public pulse cannot be amber or red.
#tlp = green
#public = false
# Days until each indicator expires on OTX.
#expiration_days = 30
# Indicators per run (one request) and per UTC day.
#max_per_run = 200
#max_per_day = 1000
# Records seen in this window are considered.
#lookback_days = 7
# Indicators remembered as sent, so none is sent twice; the oldest are dropped first.
#max_entries = 20000
# Default: otx_candidates.json next to the blocklist file (as tracked.json).
#candidates_file = /blocklist/otx_candidates.json
# Connect only to these IPv4 addresses (one per line, at most 8), the ones the host
# firewall lets this process reach (deploy/aws/host/sensor-egress.sh).
#addresses_file = /egress/otx-addresses

# STIX 2.1 bundle in a local file (off by default): python -m agents stix, and run-all when
# enabled. Nothing is sent anywhere and no credential is used. Observed-data for proven
# source addresses and stored files; indicators only for sources and file hashes that pass
# the OTX connector's promotion rules (proven source that did more than probe; the model can
# only hold one back) or that an operator approved onto the blocklist. See
# docs/portable-formats.md.
#[stix]
#enabled = false
# Default: stix/bundle.json in the reports directory.
#output_file = /reports/stix/bundle.json
# The producing identity (identity_class system). A new name starts every object afresh.
#identity_name = Honeypot sensor
# white | green | amber | red: the standard STIX TLP marking on every object.
#tlp = amber
# Also the SHA-256 of whole files the quarantine kept.
#hashes = true
# Records and stored files seen in this window are considered.
#lookback_days = 7
# A rule-promoted indicator is valid until its last sighting plus this many days. An
# operator-approved entry uses its own expires_at. A file hash does not move to another
# owner the way an address does, so it is kept longer.
#address_lifetime_days = 30
#hash_lifetime_days = 365
# Expired and revoked objects stay in the bundle this long, then are dropped.
#keep_days = 30
# Caps on the bundle: objects and bytes. Indicators are kept first when it is full.
#max_objects = 5000
#max_bytes = 8388608
