[Unit]
Description=Tailscale node serving the operator console (deploy/aws/sensor.yaml)
After=docker.service sensor-firewall.service
[Service]
Type=notify
# TS_STATE: arn:<partition>:ssm:<region>:<account>:parameter/<NamePrefix>/tailscale-state, written
# by the bootstrap. tailscaled keeps its node state there (its AWS store), not on this disk.
EnvironmentFile=/etc/sensor-tailscale.env
ExecStart=/usr/local/sbin/tailscaled --statedir=/var/lib/tailscale --state=${TS_STATE}
ExecStopPost=/usr/local/sbin/tailscaled --cleanup
Restart=on-failure
RestartSec=5
RuntimeDirectory=tailscale
StateDirectory=tailscale
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
[Install]
WantedBy=multi-user.target
